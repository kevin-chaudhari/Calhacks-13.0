# Copy to .env (git-ignored). Names only; never commit values.
# --- web (apps/web/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CONVEX_URL=
# --- api (server only) ---
COMPILER=template            # gemini | template                (Dev)
RANKER=local                 # moss | local                      (Dev)
TRANSPORT=inproc             # agentverse | bureau | inproc      (Parikshit)
PROVIDERS=seeded             # seeded | seeded+apify             (Dev)
PAYMENTS=simulated           # simulated | x402_testnet         (Kevin); anything else refuses to start
STORE=memory                 # memory | convex                  (Kevin)
DEMO_TODAY=2026-10-24
DEMO_ROUND_DELAY_MS=1400     # pacing so judges can watch rounds; 0 in tests
MAX_ROUNDS=5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash   # confirm the current model id on day one
CONVEX_URL=
RALLY_SERVER_KEY=            # same value in Convex env (npx convex env set RALLY_SERVER_KEY ...)
RALLY_SECRET=                # signs demo identity tokens
ALLOW_DEMO_ROUTES=1          # set 0 outside the demo
CORS_ORIGINS=http://localhost:3000
# --- Fetch.ai (Parikshit) ---
AGENT_SEED_PREFIX=           # per-agent seeds derived from this; never commit
AGENTVERSE_API_KEY=
RALLY_WEB_URL=http://localhost:3000   # public web URL the ASI:One concierge links to
# --- Moss / Apify (Dev) ---
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
APIFY_TOKEN=
# --- x402 testnet (Kevin) ---
X402_NETWORK=base-sepolia    # testnet only; mainnet ids are refused at startup
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_PAY_TO=                 # Rally's testnet receiving address
X402_DEPOSIT_USD=0.01        # deposit per member, in test USDC
X402_PAYER_KEYS=             # JSON {"u_kevin":"0x…", …}: testnet-only demo wallets, never real funds
