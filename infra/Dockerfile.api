# Rally API (FastAPI + agents). Build from the repo root:
#   docker build -f infra/Dockerfile.api -t rally-api .
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/services/api:/app/packages/contracts:/app \
    RALLY_RUNTIME_DIR=/data/runtime

WORKDIR /app
COPY requirements.txt .
# Optional adapters are installed so any flag can be flipped with an env var alone.
RUN pip install --no-cache-dir -r requirements.txt google-genai "x402[fastapi,httpx,evm]==2.24.0"

COPY packages/contracts packages/contracts
COPY services/api services/api
COPY agents agents
COPY data/fixtures data/fixtures

RUN useradd --system --uid 10001 rally && mkdir -p /data/runtime && chown -R rally /data
USER rally
VOLUME /data
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=3s CMD python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8000/v1/health')"
CMD ["uvicorn", "rally.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*"]
